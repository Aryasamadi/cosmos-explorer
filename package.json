{
  "name": "cosmos-explorer",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "کاوشگر سه‌بعدی زمین، ماه، خورشید و مریخ به‌همراه آسمان واقعی",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aryasamadi/cosmos-explorer.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:pages": "node scripts/verify-pages-build.mjs",
    "test:diagnostics:typecheck": "tsc -p tsconfig.diagnostics.json",
    "test:diagnostics:astronomy": "vitest run --config vitest.diagnostics.config.ts",
    "test:diagnostics:browser": "playwright test --config playwright.diagnostics.config.ts",
    "test:diagnostics": "npm run test:diagnostics:typecheck && npm run test:diagnostics:astronomy && npm run test:diagnostics:browser",
    "test:diagnostics:update": "playwright test --config playwright.diagnostics.config.ts --update-snapshots"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
